# Copy this to .env and fill in real values.
# .env is gitignored — never commit it.

CLASSCHARTS_EMAIL=your@email.com
CLASSCHARTS_PASSWORD=yourpassword

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

ANTHROPIC_API_KEY=

# Comma-separated pupil first names to match in ClassCharts
PUPIL_NAMES=Child1,Child2

# Family context passed to Claude for ad-hoc queries (run_local.py --query only)
# In production this comes from SSM. Locally, paste the same text you have in terraform.tfvars family_context.
FAMILY_CONTEXT=

# Optional: Google AI Studio key for model benchmarking (scripts/compare_models.py only)
GOOGLE_AI_STUDIO_KEY=
